/dts-v1/;
/ {
    description = "custom OS for hana";
    #address-cells = <1>;
    images {
        kernel-1 {
            description = "kernel";
            data = /incbin/("Image");
            type = "kernel";
            arch = "arm64";
            os = "linux";
            compression = "none";
            load = <0>;
            entry = <0>;
            hash-1 { algo = "sha1"; };
        };
        fdt-1 {
            description = "mt8173-elm-hana";
            data = /incbin/("mt8173-elm-hana.dtb");
            type = "flat_dt";
            arch = "arm64";
            compression = "none";
            hash-1 { algo = "sha1"; };
        };
    };
    configurations {
        default = "conf-1";
        conf-1 { description = "hana"; kernel = "kernel-1"; fdt = "fdt-1"; };
    };
};
